quit-after-last-window-closed = true
clipboard-read = allow
clipboard-write = allow
theme = light:Kanagawa Lotus,dark:Kanagawa Dragon
mouse-hide-while-typing = true
macos-titlebar-style = tabs
window-inherit-working-directory = false
working-directory = home

# Tabs, splits, and split navigation are owned by herdr, not Ghostty.
# ctrl+a is herdr's prefix -- see docs/herdr-guide.org.
#
# No `ctrl+a>` sequence may be defined here. Ghostty consumes a leader key
# (it buffers the press instead of forwarding it, which is what end_key_sequence
# exists to undo), so a single surviving ctrl+a> binding would swallow the
# prefix and herdr would never receive it.
#
# ctrl+shift+h/j/k/l is likewise left free -- herdr binds it to pane resize.
keybind = cmd+shift+r=reload_config
# keybind = global:cmd+`=toggle_quick_terminal

#
font-family = Berkeley Mono
font-style = Regular
font-style-bold = Bold
font-style-italic = Oblique
font-style-bold-italic = Bold Oblique
font-size = 15
keybind = shift+enter=text:\n

auto-update-channel = tip
