#!/bin/sh
# The themes are generated from .chezmoidata/palette.toml, so hash the RENDERED
# output. Hashing the template source would never change when the palette does,
# and bat would silently keep serving a stale cache.
# bat theme hash: {{ includeTemplate "bat-theme.tmpl" (dict "name" "Kanagawa Wave" "slug" "wave" "uuid" "c28c85eefbfb4ac28a57c9711e135172" "p" .palette.dark) | sha256sum }}
# bat theme hash: {{ includeTemplate "bat-theme.tmpl" (dict "name" "Kanagawa Lotus" "slug" "lotus" "uuid" "ac5d84cfd3924a3bb7f4a18c2957f556" "p" .palette.light) | sha256sum }}
set -eu
bat cache --build
