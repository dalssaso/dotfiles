background_selected_hover = "{{ .bg3 }}"
border_active = "{{ .blue }}"

[buttons.secondary]
background = "{{ .bg1 }}"
background_hover = "{{ .bg2 }}"
background_selected = "{{ .bg3 }}"
background_selected_hover = "{{ .bg3 }}"
border_active = "{{ .blue }}"

[buffer]
action = "{{ .green }}"
background = "{{ .bg0 }}"
background_text_input = "{{ .bg1 }}"
background_title_bar = "{{ .bg_dim }}"
border = "{{ .bg2 }}"
border_selected = "{{ .bg3 }}"
code = "{{ .aqua }}"
highlight = "{{ .bg2 }}"
nickname = "{{ .fg }}"
nickname_offline = "{{ .grey1 }}"
selection = "{{ .bg2 }}"
# Takes effect in Halloy versions after 2026.8; ignored by 2026.8.
focus_border = "{{ .blue }}"
focus_background = "{{ .bg1 }}"
self_message = "{{ .grey1 }}"
timestamp = "{{ .grey0 }}"
topic = "{{ .purple }}"
url = "{{ .blue }}"
backlog_rule = "{{ .bg2 }}"
backlog_rule_text = "{{ .grey0 }}"
date_rule = "{{ .bg2 }}"
date_rule_text = "{{ .grey0 }}"

[buffer.server_messages]
default = "{{ .grey0 }}"

[formatting]
white = "{{ .fg }}"
black = "{{ .bg_dim }}"
