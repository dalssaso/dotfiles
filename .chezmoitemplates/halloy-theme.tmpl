horizontal_rule_text = "{{ .grey0 }}"
scrollbar = "{{ .bg3 }}"
unread_indicator = "{{ .blue }}"
highlight_indicator = "{{ .orange }}"

[text]
primary = "{{ .fg }}"
secondary = "{{ .grey0 }}"
