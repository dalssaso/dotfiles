success = "{{ .green }}"
error = "{{ .red }}"
warning = "{{ .yellow }}"
info = "{{ .blue }}"
debug = "{{ .purple }}"
trace = "{{ .grey1 }}"

[buttons.primary]
background = "{{ .bg1 }}"
